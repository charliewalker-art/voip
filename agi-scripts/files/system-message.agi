#!/usr/bin/env python3
"""
system-message.agi

Joue un message système dynamique, dont le texte est stocké dans la table
ivr_system_settings (clé -> valeur). Permet de modifier ces textes sans
jamais toucher au dialplan ni au code.

Usage dans extensions.conf :
    exten => i,1,AGI(system-message.agi,invalid_number_text)
"""

import sys
import logging

sys.path.insert(0, "/var/lib/asterisk/agi-bin")
import piper_common

LOG_FILE = "/var/log/asterisk/system-message.log"
logging.basicConfig(
    filename=LOG_FILE,
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
)


def agi_read_env():
    env = {}
    while True:
        line = sys.stdin.readline().strip()
        if line == "":
            break
        if ":" in line:
            key, value = line.split(":", 1)
            env[key.strip()] = value.strip()
    return env


def agi_send(command):
    sys.stdout.write(command + "\n")
    sys.stdout.flush()
    result = sys.stdin.readline().strip()
    logging.info("AGI command: %s -> %s", command, result)
    return result


def main():
    agi_read_env()

    if len(sys.argv) < 2:
        logging.error("Aucune clé de setting fournie en argument")
        sys.exit(1)

    setting_key = sys.argv[1]
    logging.info("Message système demandé : %s", setting_key)

    try:
        text = piper_common.get_setting_text(setting_key)
    except Exception as e:
        logging.error("Impossible de récupérer le setting '%s' : %s", setting_key, e)
        sys.exit(1)

    try:
        cache_path_no_ext = piper_common.get_or_generate(text)
    except RuntimeError as e:
        logging.error("Erreur de génération : %s", e)
        sys.exit(1)

    agi_send('STREAM FILE "%s" ""' % cache_path_no_ext)


if __name__ == "__main__":
    main()
